do_install_ptest_base() {
    if [ -f /home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/run-ptest ]; then
        install -D /home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/run-ptest /home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/image/usr/lib/acl/ptest/run-ptest
    fi
    if grep -q install-ptest: Makefile; then
        oe_runmake DESTDIR=/home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/image/usr/lib/acl/ptest install-ptest
    fi
    do_install_ptest
    chown -R root:root /home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/image/usr/lib/acl/ptest

    # Strip build host paths from any installed Makefile
    for filename in builddefs; do
        for installed_ptest_file in $(find /home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/image/usr/lib/acl/ptest -type f -name $filename); do
            bbnote "Stripping host paths from: $installed_ptest_file"
            sed -e 's#/home/vinh/Yocto/poky/build-vinh/tmp/hosttools/*##g' \
                -e 's#/home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/*=#.=#g' \
                -e 's#/home/vinh/Yocto/poky/build-vinh/tmp/work/cortexa8hf-neon-poky-linux-gnueabi/acl/2.3.1-r0/*##g' \
                -i $installed_ptest_file
            if [ -n "^RPM" ]; then
               sed -E '/^RPM/d' \
                   -i $installed_ptest_file
            fi
        done
    done
}

