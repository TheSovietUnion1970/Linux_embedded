/usr/bin/gdb-multiarch ~/build_BBB_custom/linux-stable-rcn-ee/vmlinux -tui
./gdb/arm-gnu-toolchain-14.2.rel1-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-gdb ~/build_BBB_custom/linux-stable-rcn-ee/vmlinux -x debug_bbb.gdb

