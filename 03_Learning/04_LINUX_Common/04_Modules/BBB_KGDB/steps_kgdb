sudo scp ./gpio.ko debian@192.168.137.2:/home/debian

================================ [PC] - kdmx - terminal =============================
~/Downloads/agent-proxy/kdmx/kdmx -p /dev/ttyUSB0 -b 115200 -s /tmp/kdmx_status
minicom -o -w -p /dev/pts/X

================================ [BBB] - install modules =============================
sudo insmod gpio_t.ko

================================ [BBB] - check =============================
sudo cat /sys/module/gpio_t/sections/.text

================================ [BBB] - enable debug =============================
echo "ttyS0" | sudo tee /sys/module/kgdboc/parameters/kgdboc
echo "g" | sudo tee /proc/sysrq-trigger

