&spi0 {
    /*pinctrl-names = "default";*/
    /*pinctrl-0 = <&spi0_pins>;*/

	ti,pindir-d0-in-d1-out = <1>;

	/*status = "okay";*/

	spidev0: spidev@0 {
		compatible = "spi0-based-t";
		spi-max-frequency = <500000>;
		reg = <0>;
		status = "okay";
	};
};

&i2c1: i2c@4802a000 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c1_pins>;

	status = "okay";

	oled: ssd1306@3c {
		compatible = "ssd1306";
		reg = <0x3c>;
		status = "okay";
	};
};

&i2c2 {
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2_pins>;

	status = "okay";

	i2c2dev: i2c2dev@0 {
		compatible = "i2c2-based";
		clock-frequency = <400000>;
		reg = <0>;
		status = "okay";
	};
};

