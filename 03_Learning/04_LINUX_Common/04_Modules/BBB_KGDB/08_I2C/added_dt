&am33xx_pinmux {
    uart4_pins: pinmux_uart4_pins {
        pinctrl-single,pins = <
            AM33XX_PADCONF(AM335X_PIN_GPMC_WAIT0, PIN_INPUT_PULLUP, MUX_MODE6) /* P9_11: uart4_rxd */
            AM33XX_PADCONF(AM335X_PIN_GPMC_WPN, PIN_OUTPUT_PULLDOWN, MUX_MODE6) /* P9_13: uart4_txd */
        >;
    };

    uart1_pins: pinmux_uart1_pins {
        pinctrl-single,pins = <
            AM33XX_PADCONF(AM335X_PIN_UART1_RXD, PIN_INPUT_PULLUP, MUX_MODE0) /* P9_26: uart1_rxd */
            AM33XX_PADCONF(AM335X_PIN_UART1_TXD, PIN_OUTPUT_PULLDOWN, MUX_MODE0) /* P9_24: uart1_txd */
        >;
    };

    spi0_pins: pinmux_spi0_pins {
        pinctrl-single,pins = <
            AM33XX_PADCONF(AM335X_PIN_SPI0_CS0, PIN_OUTPUT_PULLUP, MUX_MODE0) /* P9_17: spi0_cs0 */
            AM33XX_PADCONF(AM335X_PIN_SPI0_D0, PIN_INPUT_PULLUP, MUX_MODE0) /* P9_21: spi0_d0 */
			AM33XX_PADCONF(AM335X_PIN_SPI0_D1, PIN_OUTPUT_PULLUP, MUX_MODE0) /* P9_18: spi0_d1 */
			AM33XX_PADCONF(AM335X_PIN_SPI0_SCLK, PIN_OUTPUT_PULLUP, MUX_MODE0) /* P9_22: spi0_sclk */
        >;
    };

    spi1_pins: pinmux_spi1_pins {
        pinctrl-single,pins = <
            AM33XX_PADCONF(AM335X_PIN_MCASP0_AHCLKR, PIN_INPUT_PULLUP, MUX_MODE3) /* P9_28: spi1_cs0 */
			/*AM33XX_PADCONF(AM335X_PIN_UART1_RTSN, PIN_INPUT_PULLUP, MUX_MODE4)*/ /* P9_19: spi1_cs1 */

            AM33XX_PADCONF(AM335X_PIN_MCASP0_FSX, PIN_INPUT_PULLUP, MUX_MODE3) /* P9_29: spi1_d0 */
			AM33XX_PADCONF(AM335X_PIN_MCASP0_AXR0, PIN_OUTPUT_PULLUP, MUX_MODE3) /* P9_30: spi1_d1 */
			AM33XX_PADCONF(AM335X_PIN_MCASP0_ACLKX, PIN_INPUT_PULLUP, MUX_MODE3) /* P9_31: spi1_sclk */
        >;
    };

    i2c1_pins: pinmux_i2c1_pins {
        pinctrl-single,pins = <
            AM33XX_PADCONF(AM335X_PIN_SPI0_CS0, PIN_OUTPUT_PULLUP, MUX_MODE2) /* P9_17: i2c1_scl */
            AM33XX_PADCONF(AM335X_PIN_SPI0_D1, PIN_OUTPUT_PULLUP, MUX_MODE2) /* P9_18: i2c1_sda */
        >;
    };

    i2c2_pins: pinmux_i2c2_pins {
        pinctrl-single,pins = <
            AM33XX_PADCONF(AM335X_PIN_SPI0_D0, PIN_INPUT_PULLUP, MUX_MODE2) /* P9_21: i2c2_scl */
            AM33XX_PADCONF(AM335X_PIN_SPI0_SCLK, PIN_INPUT_PULLUP, MUX_MODE2) /* P9_22: i2c2_sda */
        >;
    };

	irq_pin_pins: irq_pin_pins {
		pinctrl-single,pins = <
			AM33XX_IOPAD(0x840, PIN_INPUT_PULLUP | MUX_MODE7) /* P9.15, gpio1_16 as IRQ */
		>;
	};
};

/
{
	uart4_device {
		compatible = "uart4-based";
		
		reg = <0x481a8000 0x1000>;  // Single region for the entire UART4 peripheral
		
		clocks = <&l4ls_clkctrl AM3_L4LS_UART5_CLKCTRL 0>;
		clock-names = "fck";

		clock-frequency = <48000000>;

		pinctrl-names = "default";
		pinctrl-0 = <&uart4_pins>, <&irq_pin_pins>;

		/* Combine GPIO1 and UART4 interrupts */
		interrupts-extended = <&intc 45>,      /* UART4 interrupt, main intc */
							  <&gpio1 16 GPIO_ACTIVE_HIGH>; /* gpio1_16, GPIO_ACTIVE_HIGH */

		status = "okay";
	};
};

/
{
	uart1_device {
		compatible = "uart1-based";
		

		dmas = <&edma 28 0>, <&edma 29 0>;
		dma-names = "tx111", "rx111";

		dma-requests = <64>;
        #dma-cells = <2>;
        ti,tptcs = <&edma_tptc0 7>, <&edma_tptc1 5>, <&edma_tptc2 0>;
		ti,edma-memcpy-channels = <20 21>;


		reg = <0x48022000 0x1000>;  // Single region for the entire UART4 peripheral
		
		clocks = <&l3_clkctrl AM3_L3_TPCC_CLKCTRL 0>,
				 <&l4ls_clkctrl AM3_L4LS_UART2_CLKCTRL 0>;
		clock-names = "fck_dma", "fck_uart1";

		clock-frequency = <48000000>;

		pinctrl-names = "default";
		pinctrl-0 = <&uart1_pins>, <&irq_pin_pins>;

		/* Combine GPIO1 and UART1 interrupts */
		interrupts-extended = <&intc 73>,      /* UART1 interrupt, main intc */
							  <&gpio1 16 GPIO_ACTIVE_HIGH>, /* gpio1_16, GPIO_ACTIVE_HIGH */
							  <&intc 12>, <&intc 13>, <&intc 14>;

		status = "okay";
	};
};

/ {
    dma_device {
        compatible = "memcpy-dma-transfer";
        dmas = <&edma 20 0>;
        dma-names = "memcpy";
        status = "okay";
    };
};

&uart1 {
	compatible = "uart1-based-t";
	
