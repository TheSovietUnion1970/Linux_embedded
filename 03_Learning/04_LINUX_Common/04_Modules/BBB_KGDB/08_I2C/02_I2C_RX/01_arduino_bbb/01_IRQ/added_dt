&am33xx_pinmux {
    i2c1_pins: pinmux_i2c1_pins {
        pinctrl-single,pins = <
            AM33XX_PADCONF(AM335X_PIN_SPI0_CS0, PIN_INPUT_PULLUP, MUX_MODE2) /* P9_17: i2c1_scl */
            AM33XX_PADCONF(AM335X_PIN_SPI0_D1, PIN_INPUT_PULLUP, MUX_MODE2) /* P9_18: i2c1_sda */
        >;
    };

    i2c2_pins: pinmux_i2c2_pins {
        pinctrl-single,pins = <
			AM33XX_PADCONF(AM335X_PIN_UART1_CTSN, PIN_INPUT_PULLUP, MUX_MODE3)	/* P9_19: i2c2_scl */
			AM33XX_PADCONF(AM335X_PIN_UART1_RTSN, PIN_INPUT_PULLUP, MUX_MODE3)	/* P9_20: i2c2_sda */
        >;
    };
};

/
{
	i2c1_device {
		compatible = "i2c1-based";
		
		reg = <0x4802a000 0x1000>;  // Single region for the entire SPI1 peripheral
		
		clock-frequency = <48000000>;
		clocks = <&l4ls_clkctrl AM3_L4LS_I2C2_CLKCTRL 0>;
		clock-names = "fck-i2c1";


		pinctrl-names = "default";
		pinctrl-0 = <&i2c1_pins>;


		/* Combine I2c1 interrupts */
		interrupts-extended = <&intc 71>;
							  
		status = "okay";

	};
};

/
{
	i2c2_device {
		compatible = "i2c2-based";
		
		reg = <0x4819c000 0x1000>;  // Single region for the entire I2C2 peripheral
		
		clock-frequency = <48000000>;
		clocks = <&l4ls_clkctrl AM3_L4LS_I2C3_CLKCTRL 0>;
		clock-names = "fck-i2c2";

		pinctrl-names = "default";
		pinctrl-0 = <&i2c2_pins>;


		/* Combine I2c2 interrupts */
		interrupts-extended = <&intc 30>;
							  
		status = "okay";

	};
};
