static void bbb_uart_init_hw(struct bbb_uart *uart)
{
    u32 val;
    int retries;

    /* Disable interrupts and UART */
    iowrite32(0x0, uart->base + UART_IER);
    iowrite32(0x7, uart->base + UART_MDR1);
    udelay(100);

    /* Disable RX */
    iowrite32(0x0, uart->base + UART_MCR);

    /* Perform triple reset */
    int i = 0;
    for (i = 0; i < 3; i++) {
        iowrite32(0x2, uart->sysc);
        udelay(1000);
        do {
            val = ioread32(uart->syss);
        } while (!(val & 0x1));
        udelay(1000);
    }

    /* Disable UART again */
    iowrite32(0x7, uart->base + UART_MDR1);

    /* Clear pending interrupts and FIFO */
    ioread32(uart->base + UART_IIR);
    ioread32(uart->base + UART_LSR);
    ioread32(uart->base + UART_MSR);
    while (ioread32(uart->base + UART_LSR) & UART_LSR_DR) {
        ioread32(uart->base + UART_RHR);
    }

    /* Configure baud rate (115200) */
    iowrite32(0xBF, uart->base + UART_LCR);
    iowrite32(26 & 0xFF, uart->base + UART_DLL);
    iowrite32(0, uart->base + UART_DLH);
    iowrite32(0x03, uart->base + UART_LCR); /* 8N1 */
    udelay(100);

    /* Configure FIFOs in non-FIFO mode first */
    iowrite32(0x00, uart->base + UART_FCR); /* Disable FIFOs */
    udelay(100);
    iowrite32(0x06, uart->base + UART_FCR); /* Clear TX/RX FIFOs */
    udelay(100);

    /* Enable FIFOs with retries */
    retries = 5;
    do {
        iowrite32(0x47, uart->base + UART_FCR); /* FIFO en, TX trig=8, RX trig=16 */
        udelay(100);
        val = ioread32(uart->base + UART_FCR);
        if ((val & 0xF7) == 0x47) {
            break;
        }
        dev_err(uart->dev, "FCR retry: wrote 0x47, read 0x%x\n", val);
        iowrite32(0x00, uart->base + UART_FCR);
        iowrite32(0x06, uart->base + UART_FCR);
        udelay(1000);
    } while (--retries);
    if (retries == 0) {
        dev_err(uart->dev, "FCR configuration failed: 0x%x\n", val);
    }

    /* Enable UART */
    iowrite32(0x0, uart->base + UART_MDR1);
    udelay(100);

    /* Send test message */
    bbb_uart_send_message(uart, "Hello UART4\n");

    /* Enable RX */
    iowrite32(0x0, uart->base + UART_MCR);

    /* Enable interrupts */
    iowrite32(UART_IER_RHR_IT | UART_IER_THR_IT | UART_IER_LS_IT | UART_IER_MSI,
              uart->base + UART_IER);
    uart->interrupts_enabled = true;
}

static int bbb_uart_probe(struct platform_device *pdev)
{
    struct bbb_uart *uart;
    struct resource *res;
    int ret;

    uart = devm_kzalloc(&pdev->dev, sizeof(*uart), GFP_KERNEL);
    if (!uart)
        return -ENOMEM;

    /* Get memory resource */
    res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
    if (!res) {
        dev_err(&pdev->dev, "No memory resource\n");
        return -ENODEV;
    }

    /* Map memory region */
    uart->base = devm_ioremap_resource(&pdev->dev, res);
    if (IS_ERR(uart->base)) {
        dev_err(&pdev->dev, "Failed to map memory: %ld\n", PTR_ERR(uart->base));
        return PTR_ERR(uart->base);
    }

    /* Set control register offsets */
    uart->sysc = uart->base + UART_SYSC;
    uart->syss = uart->base + UART_SYSS;

    /* Clock setup */
    uart->clk = devm_clk_get(&pdev->dev, "fck");
    if (IS_ERR(uart->clk)) {
        dev_err(&pdev->dev, "Failed to get clock: %ld\n", PTR_ERR(uart->clk));
        return PTR_ERR(uart->clk);
    }
    ret = clk_prepare_enable(uart->clk);
    if (ret) {
        dev_err(&pdev->dev, "Failed to enable clock: %d\n", ret);
        return ret;
    }

    /* Get IRQ */
    uart->irq = platform_get_irq(pdev, 0);
    if (uart->irq < 0) {
        dev_err(&pdev->dev, "Failed to get IRQ: %d\n", uart->irq);
        clk_disable_unprepare(uart->clk);
        return uart->irq;
    }

    /* Register interrupt handler */
    ret = devm_request_irq(&pdev->dev, uart->irq, bbb_uart_irq_handler,
                           IRQF_NO_THREAD, "bbb-uart4", uart);
    if (ret) {
        dev_err(&pdev->dev, "Failed to request IRQ %d: %d\n", uart->irq, ret);
        clk_disable_unprepare(uart->clk);
        return ret;
    }

    /* Power management */
    pm_runtime_enable(&pdev->dev);
    ret = pm_runtime_get_sync(&pdev->dev);
    if (ret < 0) {
        dev_err(&pdev->dev, "Failed to enable PM: %d\n", ret);
        clk_disable_unprepare(uart->clk);
        return ret;
    }

    /* Allocate chrdev */
    ret = alloc_chrdev_region(&uart->devno, 0, 1, "bbb_uart4");
    if (ret) {
        dev_err(&pdev->dev, "Failed to allocate chrdev: %d\n", ret);
        pm_runtime_put_sync(&pdev->dev);
        clk_disable_unprepare(uart->clk);
        return ret;
    }

    /* Initialize and add cdev */
    cdev_init(&uart->cdev, &bbb_uart_fops);
    uart->cdev.owner = THIS_MODULE;
    ret = cdev_add(&uart->cdev, uart->devno, 1);
    if (ret) {
        dev_err(&pdev->dev, "Failed to add cdev: %d\n", ret);
        unregister_chrdev_region(uart->devno, 1);
        pm_runtime_put_sync(&pdev->dev);
        clk_disable_unprepare(uart->clk);
        return ret;
    }

    uart->dev = &pdev->dev;
    platform_set_drvdata(pdev, uart);

    /* Initialize hardware */
    bbb_uart_init_hw(uart);

    dev_info(&pdev->dev, "UART4 initialized: IRQ=%d, Major=%d, FCR=0x%x, IER=0x%x, Interrupts=%s\n",
             uart->irq, MAJOR(uart->devno),
             ioread32(uart->base + UART_FCR),
             ioread32(uart->base + UART_IER),
             uart->interrupts_enabled ? "enabled" : "disabled");

    return 0;
}

static int bbb_uart_remove(struct platform_device *pdev)
{
    struct bbb_uart *uart = platform_get_drvdata(pdev);

    cdev_del(&uart->cdev);
    unregister_chrdev_region(uart->devno, 1);
    pm_runtime_put_sync(&pdev->dev);
    pm_runtime_disable(&pdev->dev);
    clk_disable_unprepare(uart->clk);
    return 0;
}

static struct platform_driver bbb_uart_driver = {
    .probe = bbb_uart_probe,
    .remove = bbb_uart_remove,
    .driver = {
        .name = "bbb-uart4",
