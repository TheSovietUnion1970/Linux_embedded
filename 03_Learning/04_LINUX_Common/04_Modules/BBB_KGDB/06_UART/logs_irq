/* AM335x UART register offsets */
#define UART_THR 0x00 /* Transmit Holding Register */
#define UART_RHR 0x00 /* Receive Holding Register */
#define UART_LSR 0x14 /* Line Status Register */
#define UART_IER 0x04 /* Interrupt Enable Register */
#define UART_FCR 0x08 /* FIFO Control Register */
#define UART_LCR 0x0C /* Line Control Register */
#define UART_MCR 0x10 /* Modem Control Register */
#define UART_DLL 0x00 /* Divisor Latch Low */
#define UART_DLH 0x04 /* Divisor Latch High */
#define UART_SYSC 0x54 /* System Configuration Register */
#define UART_SYSS 0x58 /* System Status Register */
#define UART_MDR1 0x20 /* Mode Definition Register 1 */
#define UART_IIR 0x08 /* Interrupt Identification Register */
#define UART_MSR 0x18 /* Modem Status Register */

/* Line Status Register bits */
#define UART_LSR_TXFIFOE (1 << 5) /* Transmit FIFO empty */
#define UART_LSR_DR      (1 << 0) /* Data Ready */
#define UART_LSR_OE      (1 << 1) /* Overrun Error */
#define UART_LSR_PE      (1 << 2) /* Parity Error */
#define UART_LSR_FE      (1 << 3) /* Framing Error */
#define UART_LSR_BI      (1 << 4) /* Break Interrupt */

/* Interrupt Enable Register bits */
#define UART_IER_RHR_IT  (1 << 0) /* Received Data Available */
#define UART_IER_THR_IT  (1 << 1) /* Transmitter Holding Register Empty */
#define UART_IER_LS_IT   (1 << 2) /* Receiver Line Status Interrupt */
#define UART_IER_MSI     (1 << 3) /* Modem Status Interrupt */

/* Interrupt Identification Register bits */
#define UART_IIR_IT_PENDING (1 << 0) /* Interrupt pending (0 = pending) */
#define UART_IIR_RLS_IT  (0x6 << 1) /* Receiver Line Status (priority 1) */
#define UART_IIR_RHR_IT  (0x4 << 1) /* Received Data Available (priority 2) */
#define UART_IIR_THR_IT  (0x2 << 1) /* Transmitter Holding Register Empty (priority 3) */
#define UART_IIR_MSI     (0x0 << 1) /* Modem Status (priority 4) */
#define UART_IIR_CTO_IT  (0xC << 1) /* Character Timeout (priority 2) */

/* Device structure */
struct bbb_uart {
    void __iomem *base;
    void __iomem *sysc;
    void __iomem *syss;
    dev_t devno;
    struct cdev cdev;
    struct device *dev;
    struct clk *clk;
    int irq;
    bool interrupts_enabled;
};

/* Send message in polling mode */
static void bbb_uart_send_message(struct bbb_uart *uart, const char *msg)
{
    const char *p = msg;
    while (*p) {
        unsigned long timeout = jiffies + msecs_to_jiffies(50);
        u32 lsr;
        while (1) {
            lsr = ioread32(uart->base + UART_LSR);
            if (lsr & (UART_LSR_OE | UART_LSR_PE | UART_LSR_FE | UART_LSR_BI)) {
                dev_err(uart->dev, "TX error: LSR=0x%x\n", lsr);
                return;
            }
            if (lsr & UART_LSR_TXFIFOE)
                break;
            if (time_after(jiffies, timeout)) {
                dev_err(uart->dev, "TX timeout: LSR=0x%x\n", lsr);
                return;
            }
            cpu_relax();
        }
        iowrite32(*p++, uart->base + UART_THR);
    }
}

/* Interrupt handler */
static irqreturn_t bbb_uart_irq_handler(int irq, void *dev_id)
{
    struct bbb_uart *uart = dev_id;
    u32 iir, lsr, count = 0;

    do {
        iir = ioread32(uart->base + UART_IIR);
        if (iir & UART_IIR_IT_PENDING)
            break;

        lsr = ioread32(uart->base + UART_LSR);

        /* Clear RX FIFO */
        while (lsr & UART_LSR_DR) {
            ioread32(uart->base + UART_RHR);
            lsr = ioread32(uart->base + UART_LSR);
        }

        /* Handle RLS interrupt */
        if ((iir & 0xE) == UART_IIR_RLS_IT) {
            if (lsr & (UART_LSR_OE | UART_LSR_PE | UART_LSR_FE | UART_LSR_BI)) {
                dev_err(uart->dev, "RLS Error: IIR=0x%x, LSR=0x%x\n", iir, lsr);
            }
            iowrite32(0x07, uart->base + UART_FCR); /* Reset FIFOs */
            iowrite32(0x47, uart->base + UART_FCR);
        }
        /* Handle RHR or CTO */
        else if ((iir & 0xE) == UART_IIR_RHR_IT || (iir & 0xE) == UART_IIR_CTO_IT) {
            /* RX FIFO already cleared */
        }
        /* Handle THR */
        else if ((iir & 0xE) == UART_IIR_THR_IT) {
            /* No action needed for TX */
        }
        /* Handle MSI */
        else if ((iir & 0xE) == UART_IIR_MSI) {
            u32 msr = ioread32(uart->base + UART_MSR);
            dev_err(uart->dev, "MSI: IIR=0x%x, MSR=0x%x\n", iir, msr);
        }
        /* Unexpected interrupt */
        else {
            dev_err(uart->dev, "Unexpected IRQ: IIR=0x%x, LSR=0x%x\n", iir, lsr);
            iowrite32(0x07, uart->base + UART_FCR); /* Reset FIFOs */
            iowrite32(0x47, uart->base + UART_FCR);
        }

        if (++count > 20) {
            dev_err(uart->dev, "Too many interrupts: IIR=0x%x, LSR=0x%x\n", iir, lsr);
            iowrite32(0x0, uart->base + UART_IER);
            uart->interrupts_enabled = false;
            break;
        }
    } while (1);

    return IRQ_HANDLED;
}

