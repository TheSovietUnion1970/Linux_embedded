readelf --debug-dump=info ./media_home1/rootfs/boot/vmlinux | grep DW_AT_comp_dir 
-> check directory source
readelf --debug-dump=info ./media_home1/rootfs/boot/vmlinux | grep -E 'DW_AT_comp_dir|DW_AT_name'
-> check directory source | file

objdump --section-headers ./media_home1/rootfs/boot/vmlinux | grep debug_info
objdump --section-headers ./media_home1/rootfs/boot/vmlinux | grep debug_line
-> check sections like .debug_info and .debug_line are present.

