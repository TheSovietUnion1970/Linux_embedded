sudo nano /etc/systemd/system/udev-reload.service

[Unit]
Description=Reload udev rules at boot
Before=NetworkManager.service
After=systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/udevadm control --reload-rules
ExecStart=/usr/sbin/udevadm trigger
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

sudo systemctl enable udev-reload.service
